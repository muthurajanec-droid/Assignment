/******************************************************************************

QUESTION NUMBER : 19

    Program   : Replace n bits
    Purpose   : Replace n bits in first number bits from second number 
    Input     : Two Integers,Position, and Number of Bits
    Output    : Result After Bit Insertion

*******************************************************************************/
#include <stdio.h>

int main()
{
    unsigned int num1,num2,pos,n;   // Declare variables 
    unsigned int mask,result;
    printf("Enter First number :");
    scanf("%u",&num1);                    // Read the first number
    printf("Enter Second number :");
    scanf("%u",&num2);                   // Read the Second number
    printf("Enter Starting Position :");
    scanf("%u",&pos);                     // Read the starting position
    printf("Enter number of bits");
    scanf("%u",&n);                     // Read the number of bits
    
    mask=(1u<<n)-1;                         // Create a mask
    result=(num1&~(mask<<pos))|((num2&mask)<<pos);
    
    printf("Result=%u\n",result);

    return 0;
}